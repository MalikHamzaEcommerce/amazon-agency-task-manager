rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    function agencyPath(agencyId) {
      return /databases/$(database)/documents/agencies/$(agencyId);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/agency_invites/$(code);
    }

    function taskPath(taskId) {
      return /databases/$(database)/documents/tasks/$(taskId);
    }

    function myProfile() {
      return get(profilePath(request.auth.uid)).data;
    }

    function myAgency() {
      return myProfile().agency_id;
    }

    function isOwner() {
      return signedIn() && myProfile().role == 'owner';
    }

    function sameAgency(agencyId) {
      return signedIn() && agencyId != null && agencyId == myAgency();
    }

    match /profiles/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.agency_id == null
        && request.resource.data.role == 'va';

      allow get: if signedIn() && (
        request.auth.uid == uid ||
        sameAgency(resource.data.agency_id)
      );

      allow list: if signedIn() && sameAgency(resource.data.agency_id);

      allow update: if signedIn() && (
        // Anyone may change only their own display name while keeping access fields fixed.
        (request.auth.uid == uid
          && request.resource.data.agency_id == resource.data.agency_id
          && request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active)
        ||
        // First-time owner setup.
        (request.auth.uid == uid
          && resource.data.agency_id == null
          && request.resource.data.role == 'owner'
          && request.resource.data.agency_id != null
          && getAfter(agencyPath(request.resource.data.agency_id)).data.owner_id == request.auth.uid)
        ||
        // First-time VA join using the exact invite code.
        (request.auth.uid == uid
          && resource.data.agency_id == null
          && request.resource.data.role == 'va'
          && request.resource.data.join_code is string
          && get(invitePath(request.resource.data.join_code)).data.active == true
          && get(invitePath(request.resource.data.join_code)).data.agency_id == request.resource.data.agency_id)
        ||
        // Only the owner may manage members in the same agency.
        (isOwner()
          && resource.data.agency_id == myAgency()
          && request.resource.data.agency_id == resource.data.agency_id)
      );

      allow delete: if false;
    }

    match /agencies/{agencyId} {
      allow create: if signedIn()
        && request.resource.data.owner_id == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.owner_id == request.auth.uid ||
        agencyId == myAgency()
      );
      allow update: if isOwner()
        && agencyId == myAgency()
        && request.resource.data.owner_id == resource.data.owner_id;
      allow delete: if false;
    }

    match /agency_invites/{code} {
      // A signed-in user may validate only a code they already know.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && getAfter(agencyPath(request.resource.data.agency_id)).data.owner_id == request.auth.uid;
      allow update: if isOwner()
        && resource.data.agency_id == myAgency()
        && request.resource.data.agency_id == resource.data.agency_id;
      allow delete: if false;
    }

    match /accounts/{id} {
      // VAs may view accounts, but only the owner may create/edit/delete them.
      allow read: if sameAgency(resource.data.agency_id);
      allow create: if isOwner()
        && request.resource.data.agency_id == myAgency();
      allow update: if isOwner()
        && sameAgency(resource.data.agency_id)
        && request.resource.data.agency_id == resource.data.agency_id;
      allow delete: if isOwner()
        && sameAgency(resource.data.agency_id);
    }

    match /task_notes/{id} {
      // Notes are private to the agency owner and the VA currently assigned to the task.
      allow read: if signedIn()
        && get(taskPath(resource.data.task_id)).data.agency_id == myAgency()
        && (
          isOwner()
          || get(taskPath(resource.data.task_id)).data.assigned_to == request.auth.uid
        );

      // Notes are append-only. Owner may comment on any agency task; a VA may comment only
      // on a task assigned to their own login.
      allow create: if signedIn()
        && request.resource.data.agency_id == myAgency()
        && request.resource.data.author_id == request.auth.uid
        && request.resource.data.task_id is string
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 2000
        && get(taskPath(request.resource.data.task_id)).data.agency_id == myAgency()
        && (
          isOwner()
          || get(taskPath(request.resource.data.task_id)).data.assigned_to == request.auth.uid
        );

      // Keep task notes as an audit trail.
      allow update, delete: if false;
    }

    match /tasks/{id} {
      // Everyone in the agency may view tasks.
      allow read: if sameAgency(resource.data.agency_id);

      // Only the owner creates tasks.
      allow create: if isOwner()
        && request.resource.data.agency_id == myAgency();

      // Owner may edit any task. A VA may change only status/completed_at
      // on a task that is assigned to their own Firebase UID.
      allow update: if sameAgency(resource.data.agency_id)
        && request.resource.data.agency_id == resource.data.agency_id
        && (
          isOwner()
          ||
          (resource.data.assigned_to == request.auth.uid
            && request.resource.data.assigned_to == resource.data.assigned_to
            && request.resource.data.status in ['Not Started', 'In Progress', 'Waiting on Client', 'Blocked', 'Complete']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completed_at']))
        );

      // Destructive task actions are owner-only.
      allow delete: if isOwner()
        && sameAgency(resource.data.agency_id);
    }
  }
}
