rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    function agencyPath(agencyId) {
      return /databases/$(database)/documents/agencies/$(agencyId);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/agency_invites/$(code);
    }

    function taskPath(taskId) {
      return /databases/$(database)/documents/tasks/$(taskId);
    }

    function accountPath(accountId) {
      return /databases/$(database)/documents/accounts/$(accountId);
    }

    function myProfile() {
      return get(profilePath(request.auth.uid)).data;
    }

    function myAgency() {
      return myProfile().agency_id;
    }

    function isActiveMember() {
      return signedIn()
        && myProfile().agency_id != null
        && myProfile().active == true
        && (!("removed" in myProfile()) || myProfile().removed != true);
    }

    function isOwner() {
      return isActiveMember() && myProfile().role == 'owner';
    }

    function isManager() {
      return isActiveMember() && myProfile().role == 'manager';
    }

    function isLeadership() {
      return isOwner() || isManager();
    }

    function sameAgency(agencyId) {
      return isActiveMember() && agencyId != null && agencyId == myAgency();
    }

    match /profiles/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.agency_id == null
        && request.resource.data.role == 'va'
        && request.resource.data.active == true
        && request.resource.data.removed == false;

      // A user may always read their own profile so a removed/paused login can
      // receive the correct access message. Active agency members may read teammates.
      allow get: if signedIn() && (
        request.auth.uid == uid ||
        sameAgency(resource.data.agency_id)
      );

      allow list: if signedIn() && sameAgency(resource.data.agency_id);

      allow update: if signedIn() && (
        // A user may change only their own display name.
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['full_name']))
        ||
        // First-time owner setup.
        (request.auth.uid == uid
          && resource.data.agency_id == null
          && resource.data.role == 'va'
          && resource.data.active == true
          && resource.data.removed == false
          && request.resource.data.role == 'owner'
          && request.resource.data.agency_id != null
          && request.resource.data.active == true
          && request.resource.data.removed == false
          && getAfter(agencyPath(request.resource.data.agency_id)).data.owner_id == request.auth.uid)
        ||
        // First-time VA join using the exact invite code.
        (request.auth.uid == uid
          && resource.data.agency_id == null
          && resource.data.role == 'va'
          && resource.data.active == true
          && resource.data.removed == false
          && request.resource.data.role == 'va'
          && request.resource.data.active == true
          && request.resource.data.removed == false
          && request.resource.data.join_code is string
          && get(invitePath(request.resource.data.join_code)).data.active == true
          && get(invitePath(request.resource.data.join_code)).data.agency_id == request.resource.data.agency_id)
        ||
        // Owner may edit a current teammate's name/role/status, but may not
        // demote or pause the agency owner account.
        (isOwner()
          && resource.data.agency_id == myAgency()
          && (!("removed" in resource.data) || resource.data.removed != true)
          && request.resource.data.agency_id == resource.data.agency_id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['full_name', 'role', 'active'])
          && (
            (uid == request.auth.uid
              && resource.data.role == 'owner'
              && request.resource.data.role == 'owner'
              && request.resource.data.active == true)
            ||
            (uid != request.auth.uid
              && resource.data.role != 'owner'
              && request.resource.data.role in ['va', 'manager'])
          ))
        ||
        // Managers may edit current VAs, but cannot grant Manager access or
        // modify Owner/Manager accounts. Role changes remain Owner-only.
        (isManager()
          && uid != request.auth.uid
          && resource.data.agency_id == myAgency()
          && resource.data.role == 'va'
          && (!('removed' in resource.data) || resource.data.removed != true)
          && request.resource.data.agency_id == resource.data.agency_id
          && request.resource.data.role == 'va'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['full_name', 'active']))
        ||
        // Owner may remove a non-owner teammate. This is a secure soft-delete:
        // the profile remains for audit/history but loses all agency access.
        ((isOwner() || (isManager() && resource.data.role == 'va'))
          && uid != request.auth.uid
          && resource.data.agency_id == myAgency()
          && resource.data.role != 'owner'
          && request.resource.data.agency_id == resource.data.agency_id
          && request.resource.data.active == false
          && request.resource.data.removed == true
          && request.resource.data.removed_by == request.auth.uid
          && request.resource.data.removed_at is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'removed', 'removed_at', 'removed_by']))
        ||
        // Owner may restore any non-owner teammate; Managers may restore VAs only.
        // The Firebase Auth login is kept, so the same email/password still works.
        // is kept, so the VA can use the exact same email/password after restore.
        ((isOwner() || (isManager() && resource.data.role == 'va'))
          && uid != request.auth.uid
          && resource.data.agency_id == myAgency()
          && resource.data.role != 'owner'
          && resource.data.removed == true
          && request.resource.data.agency_id == resource.data.agency_id
          && request.resource.data.active == true
          && request.resource.data.removed == false
          && request.resource.data.restored_by == request.auth.uid
          && request.resource.data.restored_at is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'removed', 'restored_at', 'restored_by']))
      );

      allow delete: if isOwner()
        && uid != request.auth.uid
        && resource.data.agency_id == myAgency()
        && resource.data.role != 'owner'
        && resource.data.removed == true;
    }

    match /agencies/{agencyId} {
      allow create: if signedIn()
        && request.resource.data.owner_id == request.auth.uid;
      allow read: if sameAgency(agencyId);
      allow update: if isLeadership()
        && agencyId == myAgency()
        && request.resource.data.owner_id == resource.data.owner_id;
      allow delete: if false;
    }

    match /agency_invites/{code} {
      // A signed-in, not-yet-attached user may validate a code they already know.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && (
          getAfter(agencyPath(request.resource.data.agency_id)).data.owner_id == request.auth.uid
          || (isLeadership() && request.resource.data.agency_id == myAgency())
        );
      allow update: if isLeadership()
        && resource.data.agency_id == myAgency()
        && request.resource.data.agency_id == resource.data.agency_id;
      allow delete: if false;
    }

    match /accounts/{id} {
      allow read: if sameAgency(resource.data.agency_id);
      allow create: if isLeadership()
        && request.resource.data.agency_id == myAgency();
      allow update: if isLeadership()
        && sameAgency(resource.data.agency_id)
        && request.resource.data.agency_id == resource.data.agency_id;
      allow delete: if isLeadership()
        && sameAgency(resource.data.agency_id);
    }

    match /account_credentials/{accountId} {
      allow get: if isLeadership()
        && get(accountPath(accountId)).data.agency_id == myAgency();
      allow list: if false;
      allow create: if isLeadership()
        && request.resource.data.agency_id == myAgency()
        && request.resource.data.account_id == accountId
        && get(accountPath(accountId)).data.agency_id == myAgency();
      allow update: if isLeadership()
        && resource.data.agency_id == myAgency()
        && request.resource.data.agency_id == resource.data.agency_id
        && request.resource.data.account_id == accountId
        && get(accountPath(accountId)).data.agency_id == myAgency();
      allow delete: if isLeadership()
        && resource.data.agency_id == myAgency()
        && get(accountPath(accountId)).data.agency_id == myAgency();
    }

    match /task_notes/{id} {
      allow read: if signedIn()
        && sameAgency(get(taskPath(resource.data.task_id)).data.agency_id)
        && (
          isLeadership()
          || get(taskPath(resource.data.task_id)).data.assigned_to == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.agency_id == myAgency()
        && request.resource.data.author_id == request.auth.uid
        && request.resource.data.task_id is string
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 2000
        && sameAgency(get(taskPath(request.resource.data.task_id)).data.agency_id)
        && (
          isLeadership()
          || get(taskPath(request.resource.data.task_id)).data.assigned_to == request.auth.uid
        );

      allow update, delete: if false;
    }

    match /tasks/{id} {
      allow read: if sameAgency(resource.data.agency_id);

      allow create: if (isLeadership()
        && request.resource.data.agency_id == myAgency())
        || (
          isActiveMember()
          && request.resource.data.agency_id == myAgency()
          && request.resource.data.generated_by_recurrence == true
          && request.resource.data.recurrence_parent_id is string
          && request.resource.data.series_id is string
          && request.resource.data.recurrence_index is int
          && request.resource.data.recurrence_index > 0
          && request.resource.data.status == 'Not Started'
          && request.resource.data.completed_at == null
          && request.resource.data.recurring == true
          && request.resource.data.created_by == request.auth.uid
          && getAfter(taskPath(request.resource.data.recurrence_parent_id)).data.agency_id == myAgency()
          && getAfter(taskPath(request.resource.data.recurrence_parent_id)).data.assigned_to == request.auth.uid
          && getAfter(taskPath(request.resource.data.recurrence_parent_id)).data.status == 'Completed'
          && getAfter(taskPath(request.resource.data.recurrence_parent_id)).data.recurring == true
          && request.resource.data.account_id == getAfter(taskPath(request.resource.data.recurrence_parent_id)).data.account_id
          && request.resource.data.title == getAfter(taskPath(request.resource.data.recurrence_parent_id)).data.title
          && request.resource.data.assigned_to == getAfter(taskPath(request.resource.data.recurrence_parent_id)).data.assigned_to
          && request.resource.data.recurrence == getAfter(taskPath(request.resource.data.recurrence_parent_id)).data.recurrence
        );

      allow update: if sameAgency(resource.data.agency_id)
        && request.resource.data.agency_id == resource.data.agency_id
        && (
          isLeadership()
          ||
          (resource.data.assigned_to == request.auth.uid
            && request.resource.data.assigned_to == resource.data.assigned_to
            && request.resource.data.status in ['Not Started', 'In Progress', 'Awaiting', 'Waiting on Client', 'Blocked', 'Completed']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completed_at']))
        );

      allow delete: if isLeadership()
        && sameAgency(resource.data.agency_id);
    }
  }
}
